//html

{
	// Place your snippets for HTML here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	//
	// You can also restrict snippets to specific files using include/exclude patterns:
	// "Test snippet": {
	// 	"prefix": "test",
	// 	"body": "test('$1', () => {\n\t$0\n});",
	// 	"include": ["**/*.test.ts", "*.spec.ts"],
	// 	"exclude": ["**/temp/*.ts"],
	// 	"description": "Insert test block"
	// }
	
    "PHP echo": {
        "prefix": "echo",
        "body": [
            "<?php echo \"$1\"; ?>"
        ],
        "description": "Crea un echo de PHP"
    },

	"PHP echo sin": {
		"prefix": "echos",
		"body": [
			"<?php echo $1; ?>"
		],
		"description": "Crea un echo de PHP sin comillas"
	},

	"PHP normal":{
		"prefix": "php",
		"body": ["<?php $1 ; ?>"
		],
		"description": "Crea una etiqueta php"
	},

	"?":{
		"prefix": "??",
		"body": ["<? $1 ?>"
		],
		"description": "Crea una etiqueta ?"
	},

	"forphp": {
		"prefix": "forphp",
		"body": [
			"<?php",
			"foreach ($1 as $2 => $3) { ?>",
			"    <?php $0; ?>",
			"<?php } ?>"
		],
		"description": "Crea un foreach con etiquetas de PHP"
	},

	"tabla": {
		"prefix": "tabla",
		"body": [
			"<table>",
			"    <tr>",
			"        <th>$1</th>",
			"        <th>$2</th>",
			"    </tr>",
			"    <?php foreach ($3 as $4 => $5) { ?>",
			"        <tr>",
			"            <td><?= $4 ?></td>",
			"            <td><?= $5 ?></td>",
			"        </tr>",
			"    <?php } ?>",
			"</table>",
			"",
			"$0"
		],
		"description": "Crea una tabla HTML con foreach"
	},

	
    "Bootstrap": {
        "prefix": "bootstrap",
        "body": [
            "<link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css\" rel=\"stylesheet\">",
            "<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js\"></script>"
        ],
        "description": "Añade Bootstrap CSS y JS"
    },

	"Código básico de HTML": {
    "prefix": "!!",
    "body": [
        "<!DOCTYPE html>",
        "<html lang=\"es\">",
        "<head>",
        "    <meta charset=\"UTF-8\">",
        "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
        "    <title>$1</title>",
        "    <link rel=\"stylesheet\" href=\"$2\">",
        "</head>",
        "<body>",
        "    $3",
        "</body>",
        "</html>"
    ],
    "description": "Plantilla básica de HTML"
	},

	"tablaa": {
    "prefix": "tablaa",
    "body": [
        "<table>",
        "    <!-- Encabezado de la tabla -->",
        "    <tr>",
        "        <th>$1</th>",
        "        <th>$2</th>",
        "    </tr>",
        "",
        "    <!-- Filas de datos -->",
        "    <tr>",
        "        <td>$3</td>",
        "        <td>$4</td>",
        "    </tr>",
        "</table>",
        "",
        "$0"
    ],
    "description": "Crea una tabla HTML con comentarios"
	},

	
	
	"Plantilla HTML de ejercicios": {
		"prefix": "plantilla",
		"body": [
		"<!DOCTYPE html>",
		"<html lang=\"es\">",
		"<head>",
		"    <meta charset=\"UTF-8\">",
		"    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
		"    <title>${TM_FILENAME_BASE/([^0-9]*\\S)\\s*([0-9]+)$/${1:/capitalize} $2/}</title>",
		"    <link rel=\"stylesheet\" href=\"estilos.css\">",
		"</head>",
		"<body>",
		"    <h1>${TM_DIRECTORY/.*Rico Practica\\s+(.+)$/$1/i}</h1>",
		"    <h2>Izan Rico Blanco</h2>",
		"    <h2 class=\"titulo_ejercicios\">Ejercicio ${TM_FILENAME_BASE/^[^0-9]*([0-9]+).*?$/$1/}</h2>",
		"    <script>",
		"        ${3}",
		"    </script>",
		"</body>",
		"</html>",
		"$0"
		],
		"description": "Plantilla HTML para ejercicios"
	}

	
}




//javascript

{
    "println": {
        "prefix": "println",
        "body": [
            "document.write(\"$1\"$2, \"<br>\");",
            "$3"
        ],
        "description": "Crea un document.write con comillas y salto de línea"
    },

    "print": {
        "prefix": "print",
        "body": [
            "document.write(\"$1\"$2);",
            "$3"
        ],
        "description": "Crea un document.write con comillas y sin salto de línea"
    },

    "printlns": {
        "prefix": "printlns",
        "body": [
            "document.write($1, $2 \"<br>\");",
            "$3"
        ],
        "description": "Crea un document.write sin comillas y con salto de línea"
    },

    "prints": {
        "prefix": "prints",
        "body": [
            "document.write($1);",
            "$2"
        ],
        "description": "Crea un document.write sin comillas y sin salto de línea"
    },

    "pedir": {
    "prefix": "pedir",
    "body": [
        "prompt(\"$1\");",
        "$2"
    ],
    "description": "Crea un prompt para solicitar información al usuario"
}
}